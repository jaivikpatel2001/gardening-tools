# =============================================================================
# GreenTools environment configuration
#
# Copy this file to `.env.local` for local development:
#
#     cp .env.example .env.local
#
# Only this template is committed. `.env.local` and every other `.env*` file are
# gitignored. Never commit API keys, passwords, SMTP credentials, private tokens
# or production secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time and are visible to anyone. Never put a secret in one.
#
# Values are read and validated in `config/env.ts`. Nothing else reads
# process.env directly.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime environment
# -----------------------------------------------------------------------------

# NODE_ENV is set by Next.js itself: "development" for `next dev`, "production"
# for `next build` and `next start`. Do not set it manually, because a hand-set
# value produces inconsistent builds. It is listed here only so nobody adds it.
# NODE_ENV=development

# Which deployment this is: development | staging | production
#
# Staging builds still run with NODE_ENV=production, so this is the variable
# that tells staging and production apart. Any value other than "production"
# makes every page `noindex` and serves a disallow-all robots.txt, so previews
# never appear in search results. Unset or unrecognised values count as
# "development".
#
# LAUNCH CHECKLIST: the live deployment must set this to "production", or the
# site will not be indexed.
NEXT_PUBLIC_APP_ENV=development

# Canonical origin with no trailing slash. Drives canonical URLs, Open Graph
# URLs, the sitemap, robots.txt and structured data.
# Falls back to https://www.jivagreens.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# WhatsApp (in use)
# -----------------------------------------------------------------------------

# Number for the floating WhatsApp button. Full international format, digits
# only, no "+" and no spaces: country code 91 followed by the 10-digit mobile,
# for example 91XXXXXXXXXX.
#
# Leave empty to hide the button. A value that is not 11 to 15 digits is
# treated as empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# -----------------------------------------------------------------------------
# Contact form and email (future scope, not built yet)
# -----------------------------------------------------------------------------

# Where enquiries are delivered, and the address they are sent from.
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=

# SMTP delivery
SMTP_HOST=
SMTP_PORT=
# "true" for port 465, "false" for STARTTLS on 587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Transactional email provider, as an alternative to SMTP
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# Bot protection for public forms
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=


# -----------------------------------------------------------------------------
# Analytics (future scope)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=


# -----------------------------------------------------------------------------
# CMS (future scope)
# -----------------------------------------------------------------------------

CMS_API_URL=
CMS_API_TOKEN=
CMS_PREVIEW_SECRET=
CMS_REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# API endpoints and third-party integrations (future scope)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=
API_SECRET_KEY=
